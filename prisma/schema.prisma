// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  password     String
  dateOfBirth  DateTime?
  gender       String?
  insurance    String?
  role         Role          @default(USER)
  specialist  String  @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
  GuestAppointment GuestAppointment[]
}

model Clinician {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?
  specialty         Specialty?         @relation(fields: [specialtyId], references: [id])
  specialtyId       String?
  role              Role               @default(CLINICIAN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("clinicians")
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum Role {
  USER
  CLINICIAN
  ADMIN
}
model GuestAppointment {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  status      String    @default("pending")
  gender      String
  appoint_date DateTime
  appoint_time  String
  reason String
  clinician   User @relation(fields: [clinicianId], references: [id])
  clinicianId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Specialty {
  id         String      @id @default(uuid())
  name       String      @unique
  clinicians Clinician[]
}
